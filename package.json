{
  "name": "seacs-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic public reference simulator for bounded autonomous control decisions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "artifacts": "node --experimental-strip-types scripts/generate-artifacts.ts",
    "replay": "node --experimental-strip-types scripts/replay-artifact.ts",
    "verify": "npm test && npm run build && npm run replay"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.4.3",
    "typescript": "~5.8.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/node": "^22.14.0"
  }
}
